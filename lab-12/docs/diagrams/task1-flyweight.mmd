classDiagram
direction TB

class RouteMap {
  -List~CarMarker~ markers
  +addMarker(CarMarker marker) void
  +getMarker(int index) CarMarker
  +getMarkerCount() int
}
class CarMarker {
  -String plate
  -double latitude
  -double longitude
  -String time
  -CarModel model
  +getModel() CarModel
  +describe() String
}
class CarModelFactory {
  -Map~String, CarModel~ models
  +getModel(String name, String icon, String characteristics, String photo) CarModel
  +getModelCount() int
}
class CarModel {
  -String name
  -String icon
  -String characteristics
  -String photo
  +getName() String
  +getIcon() String
  +getCharacteristics() String
  +getPhoto() String
}

RouteMap "1" o--> "0..*" CarMarker : markers
CarMarker "0..*" --> "1" CarModel : model
CarModelFactory "1" *--> "0..*" CarModel : models (пул)

note for RouteMap "Роль: Client<br>зберігає позначки"
